# ============================================================================
# FILE: .env.example
# LOCATION: backend/.env.example
# PURPOSE: Document infrastructure-only server settings.
# ROLE IN PROJECT: Copied only when local configuration does not already exist.
# KEY COMPONENTS: Server identity, service settings, guarded topology and budgets.
# ============================================================================
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Legacy owner selector for explicit operator adoption only; not browser login.
AURVIN_USER_ID=aurvin-dev-user
# Backend-only WorkOS custom password sessions. All blank: diagnostic-only.
# Set all three privately; cookie password needs at least 32 characters.
# Rotation signs everyone out. Never copy these into VITE_* settings.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=

# unknown | native-mongodb | cosmos-mongodb-ru | azure-documentdb
PERSISTENCE_PROFILE=unknown
MONGODB_URI=
MONGODB_DB_NAME=aurvin

# Backend-only 32-byte master key for stored provider credentials, base64.
# Generate once privately, back it up separately with restricted access, and
# never share logs/screenshots/history containing it. Losing it makes stored
# credentials unusable. This example does not configure text/voice settings:
# manageable values live in the MongoDB config collection via Super admin ->
# Manage Aurvin, never in this file.
AURVIN_CONFIG_ENCRYPTION_KEY=

# LiveKit bootstrap settings below are infrastructure-only, not manageable values.
# Optional LiveKit bootstrap-only infrastructure for live WebRTC; all blank is absent.
# Private server environment only; never VITE_* or a Manage Aurvin credential card.
# Configure all three together after hosting/access approval; partial values fail startup.
# Production requires trusted wss:// signaling; ws:// is non-production loopback only.
# Changes require controlled restart/drain; these entries do not enable a voice mode.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Phase 1 allows only single-process execution.
AURVIN_EXECUTOR_TOPOLOGY=single-process
# Opt-in Windows local recovery for idle/provider windows; busy/unknown writes refuse.
# Requires explicit native replica-set URI; legacy owners need one-time operator recovery.
AURVIN_LOCAL_CRASH_RECOVERY=false
# Optional stdout traces: default is quiet (outcomes, faults, readiness, recovery, shutdown).
# AURVIN_LOG_LEVEL=debug

# Optional infrastructure/storage/shutdown overrides; unset values use DEFAULT_BUDGETS.
# These ceilings bound every manageable setting; they never enable chat or voice.
# MAX_MESSAGE_BYTES=
# MAX_DOCUMENT_BYTES=
# MAX_MANIFEST_BYTES=
# MAX_PAGE_SIZE=
# DEFAULT_PAGE_SIZE=
# CONNECT_TIMEOUT_MS=
# PERSISTENCE_TIMEOUT_MS=
# SHUTDOWN_DRAIN_MS=

# Legacy manageable environment names (OPENROUTER_API_KEY, OPENROUTER_MODEL,
# ENABLE_DICTATION_MODE, ENABLE_LIVE_VOICE_MODE, DEEPGRAM_API_KEY, voice/chat
# budget overrides, and the full list in docs/super-admin-config/operations.md)
# are ignored at startup with a name-only warning. They are read only by the
# explicit one-time import command documented in that runbook. Remove migrated
# entries manually after a successful import; keep the infrastructure settings
# above and the master key.


# Optional local Google Calendar infrastructure; all blank means absent/default-off.
# Operator-approved OAuth/privacy setup is still required. No target ID is needed.
# Policy flags default false, content permission defaults volatile, timezone defaults Etc/UTC.
# Leave every value blank until privately configured; never put these in VITE_*.
# AURVIN_GOOGLE_CALENDAR_TARGET_ID is deprecated and ignored, not a default setting.
AURVIN_GOOGLE_CALENDAR_CLIENT_ID=
AURVIN_GOOGLE_CALENDAR_CLIENT_SECRET=
AURVIN_GOOGLE_CALENDAR_REDIRECT_URI=
AURVIN_GOOGLE_CALENDAR_PROCESSING_POLICY_ID=
AURVIN_GOOGLE_CALENDAR_POLICY_APPROVED=
AURVIN_GOOGLE_CALENDAR_CONTENT_PERMISSION=
AURVIN_GOOGLE_CALENDAR_MINIMAL_EVIDENCE_ALLOWED=
AURVIN_GOOGLE_CALENDAR_POLICY_DEADLINE_AT=
AURVIN_GOOGLE_CALENDAR_TIME_ZONE=
